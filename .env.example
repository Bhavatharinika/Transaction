# ---------- Infrastructure ----------
POSTGRES_USER=tps
POSTGRES_PASSWORD=tps-local-dev
POSTGRES_DB=tps
# docker-compose derives DATABASE_URL, REDIS_URL and MOCK_SERVICE_URL for the containers.
# For running the backend outside Docker set: DATABASE_URL, REDIS_URL, MOCK_SERVICE_URL (see README).

# ---------- API ----------
API_WORKERS=4
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20

# ---------- Backpressure ----------
QUEUE_MAX_DEPTH=50000
MAX_OPEN_TRANSACTIONS=200000
LOAD_SHED_REFRESH_SECONDS=1.0
RETRY_AFTER_SECONDS=5

# ---------- Workers ----------
WORKER_REPLICAS=2
WORKER_CONCURRENCY=150
LEASE_TTL_SECONDS=10
LEASE_HEARTBEAT_SECONDS=3
RECONCILE_INTERVAL_SECONDS=1.0
RECONCILE_BATCH_SIZE=500
REQUEUE_AFTER_SECONDS=20
SHUTDOWN_GRACE_SECONDS=30

# ---------- Posting service client ----------
MOCK_CONNECT_TIMEOUT_SECONDS=3
MOCK_GET_TIMEOUT_SECONDS=5
# Must exceed the mock's worst-case latency (10s) so a timeout means "genuinely unresponsive".
MOCK_POST_TIMEOUT_SECONDS=15
MOCK_MAX_CONNECTIONS=200
# After an uncertain POST, wait at least this long (measured from POST start) before verifying.
VERIFICATION_SETTLE_SECONDS=12

# ---------- Retry (exponential backoff + jitter) ----------
RETRY_MAX_RETRIES=5
RETRY_INITIAL_DELAY_SECONDS=1
RETRY_MAX_DELAY_SECONDS=60
RETRY_JITTER_RATIO=0.2

# ---------- Circuit breaker ----------
CIRCUIT_WINDOW_SIZE=20
CIRCUIT_MIN_CALLS=10
CIRCUIT_FAILURE_RATIO=0.5
CIRCUIT_OPEN_SECONDS=15
CIRCUIT_HALF_OPEN_MAX_CALLS=3
